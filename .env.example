# Node.js 24.10+ (26 recommended). Never put these values in public/.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
DATABASE_PATH=./private/runtime/campusready.sqlite

# Paste your Google AI Studio API key here. Only the backend reads it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT=30

# Razorpay: configure all three for checkout and signed payment webhooks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# An isolated Judge0 CE-compatible service. Never execute student code on the app host.
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=
